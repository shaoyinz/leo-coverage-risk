%% LEO coverage-risk pipeline — agent / tool / dataflow architecture.
%% Mirrors the inline diagram in docs/architecture.md (six-role design).
%% Render: https://mermaid.live or `mmdc -i architecture.mmd -o architecture.svg`

flowchart TB
    subgraph Human["👤 Human-in-the-loop gates"]
        H1["Approve data manifest<br/>(cost / licensing)"]
        H2["Review anomalies<br/>& sign off insights"]
    end

    SPEC["📖 Obstruction spec — pre-approved config<br/>θ_min · azimuth weighting · risk tiers<br/>(domain research already done)"]

    ORCH["🧭 Orchestrator / Planner<br/>(owns run + state + gates)"]

    subgraph Agents["Scoped sub-agents — LLM reasons, tools compute"]
        A1["🔎 Data-Discovery<br/>STAC / catalog search → manifest<br/><i>get_aoi_bbox · stac_search · opendata_registry_search · write_data_manifest · WebSearch/WebFetch</i>"]
        A2["⬇️ Ingestion<br/>COG windows → aligned mosaic / pseudo-DSM<br/><i>stac_item_read · fetch_aligned_surface · cache_rw</i>"]
        A3["📐 Analysis<br/>horizon/viewshed → obstruction% → tier<br/><i>compute_sky_obstruction · find_clear_sky_spot</i>"]
        A4["✅ Validation/QA<br/>input dedup + output anomaly checks<br/><i>qa_input_audit · qa_location_batch · query_locations · WebFetch</i>"]
        A5["📝 Reporting/Insight<br/>aggregates + map + decision log<br/><i>aggregate_findings · render_map · write_report · query_locations</i>"]
    end

    subgraph Ext["External services / data"]
        E1["STAC: Planetary Computer /<br/>Earth Engine / AWS Open Data"]
        E2["COG stores: 3DEP DSM/DEM,<br/>Meta/ETH canopy, NLCD TCC"]
    end

    STATE[("🗄️ State store<br/>DuckDB/PostGIS + GeoParquet/COG cache<br/>keyed by location_id & tile_id")]
    OBS["📊 Observability<br/>tokens · latency · tool-call accuracy · drift"]

    SPEC --> ORCH
    ORCH --> A1 --> E1
    A1 -.manifest.-> H1 --> ORCH
    ORCH --> A2 --> E2
    A2 --> STATE
    ORCH --> A3 --> STATE
    SPEC -.params.-> A3
    ORCH --> A4 --> STATE
    A4 -.anomalies.-> H2 --> ORCH
    ORCH --> A5 --> STATE
    A5 -.insights.-> H2
    Agents -.traces.-> OBS
