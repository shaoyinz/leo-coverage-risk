# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/

# Virtual environments (shared venv lives at repo-parent ../../.venv)
.venv/
venv/
env/

# Secrets
.env
.env.local

# Data — provided Locations CSV (~1M rows) is not committed
data/raw/*
!data/raw/README.md
data/interim/*
!data/interim/.gitkeep

# Outputs — generated maps / figures.
# The large source artifacts (locations.geojson ~1GB, run logs) stay ignored; the small,
# reviewer-facing result files below ARE committed so the findings + map read from a clone.
outputs/*
!outputs/.gitkeep
!outputs/decision_log.md
!outputs/aggregates.json
!outputs/coverage_map.png
!outputs/coverage_map.html
!outputs/locations.pmtiles

docs/walkthrough/*

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
